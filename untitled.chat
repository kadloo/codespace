in the 'jupyter_server_mcp.middleware' group\"\n104:         ),\n105:     ).tag(config=True)\n106: \n107:     mcp_server_instance: object | None = None\n108:     mcp_server_task: asyncio.Task | None = None\n109:     mcp_shutdown_timeout = 5\n110:     mcp_startup_timeout = 10\n111:     _runtime_info_path: Path | None = None\n112: \n113:     def _load_function_from_string(self, tool_spec: str):\n114:         \"\"\"Load a function from a string specification.\n115: \n116:         Args:\n117:             tool_spec: Function specification in format\n118:                 'module_path:function_name'\n119: \n120:         Returns:\n121:             The loaded function object\n122: \n123:         Raises:\n124:             ValueError: If tool_spec format is invalid\n125:             ImportError: If module cannot be imported\n126:             AttributeError: If function not found in module\n127:         \"\"\"\n128:         if \":\" not in tool_spec:\n129:             msg = (\n130:                 f\"Invalid tool specification '{tool_spec}'. \"\n131:                 f\"Expected format: 'module_path:function_name'\"\n132:             )\n133:             raise ValueError(msg)\n134: \n135:         module_path, function_name = tool_spec.rsplit(\":\", 1)\n136: \n137:         try:\n138:             module = importlib.import_module(module_path)\n139:             return getattr(module, function_name)\n140:         except ImportError as e:\n141:             msg = f\"Could not import module '{module_path}': {e}\"\n142:             raise ImportError(msg) from e\n143:         except AttributeError as e:\n144:             msg = f\"Function '{function_name}' not found in module '{module_path}': {e}\"\n145:             raise AttributeError(msg) from e\n146: \n147:     def _register_tools(self, tool_specs: list[str], source: str = \"configuration\"):\n148:         \"\"\"Register tools from a list of tool specifications.\n149: \n150:         Args:\n151:             tool_specs: List of tool specifications in 'module:function' format\n152:             source: Description of where tools came from (for logging)\n153:         \"\"\"\n154:         if not tool_specs:\n155:             return\n156: \n157:         logger.info(f\"Registering {len(tool_specs)} tools from {source}\")\n158: \n159:         for tool_spec in tool_specs:\n160:             try:\n161:                 function = self._load_function_from_string(tool_spec)\n162:                 self.mcp_server_instance.register_tool(function)\n163:                 logger.info(f\"\u2705 Registered tool from {source}: {tool_spec}\")\n164:             except Exception as e:  # noqa: BLE001\n165:                 logger.error(\n166:                     f\"\u274c Failed to register tool '{tool_spec}' from {source}: {e}\"\n167:                 )\n168:                 continue\n169: \n170:     def _discover_entrypoint_tools(self) -> list[str]:\n171:         \"\"\"Discover tools from Python entrypoints in the 'jupyter_server_mcp.tools' group.\n172: \n173:         Returns:\n174:             List of tool specifications in 'module:function' format\n175:         \"\"\"\n176:         if not self.use_tool_discovery:\n177:             return []\n178: \n179:         discovered_tools = []\n180: \n181:         try:\n182:             # Use importlib.metadata to discover entrypoints\n183:             entrypoints = importlib.metadata.entry_points()\n184: \n185:             # Handle both Python 3.10+ and 3.9 style entrypoint APIs\n186:             if hasattr(entrypoints, \"select\"):\n187:                 tools_group = entrypoints.select(group=\"jupyter_server_mcp.tools\")\n188:             else:\n189:                 tools_group = entrypoints.get(\"jupyter_server_mcp.tools\", [])\n190: \n191:             for entry_point in tools_group:\n192:                 try:\n193:                     # Load the entrypoint value (can be a list or a function that returns a list)\n194:                     loaded_value = entry_point.load()\n195: \n196:                     # Get tool specs from either a list or callable\n197:                     if isinstance(loaded_value, list):\n198:                         tool_specs = loaded_value\n199:                     elif callable(loaded_value):\n200:                         tool_specs = loaded_value()\n201:                         if not isinstance(tool_specs, list):\n202:                             logger.warning(\n203:                                 f\"Entrypoint '{entry_point.name}' function returned \"\n204:                                 f\"{type(tool_specs).__name__} instead of list, skipping\"\n205:                             )\n206:                             continue\n207:                     else:\n208:                         logger.warning(\n209:                             f\"Entrypoint '{entry_point.name}' is neither a list nor callable, skipping\"\n210:                         )\n211:                         continue\n212: \n213:                     # Validate and collect tool specs\n214:                     valid_specs = [spec for spec in tool_specs if isinstance(spec, str)]\n215:                     invalid_count = len(tool_specs) - len(valid_specs)\n216: \n217:                     if invalid_count > 0:\n218:                         logger.warning(\n219:                             f\"Skipped {invalid_count} non-string tool specs from '{entry_point.name}'\"\n220:                         )\n221: \n222:                     discovered_tools.extend(valid_specs)\n223:                     logger.info(\n224:                         f\"Discovered {len(valid_specs)} tools from entrypoint '{entry_point.name}'\"\n225:                     )\n226: \n227:                 except Exception as e:  # noqa: BLE001\n228:                     logger.error(f\"Failed to load entrypoint '{entry_point.name}': {e}\")\n229:                     continue\n230: \n231:         except Exception as e:  # noqa: BLE001\n232:             logger.error(f\"Failed to discover entrypoints: {e}\")\n233: \n234:         if not discovered_tools:\n235:             logger.info(\"No tools discovered from entrypoints\")\n236: \n237:         return discovered_tools\n238: \n239:     def _add_middleware(\n240:         self, middleware_specs: list[str], source: str = \"configuration\"\n241:     ):\n242:         \"\"\"Add middleware from a list of specifications.\n243: \n244:         Args:\n245:             middleware_specs: List of specifications in 'module:factory' format\n246:             source: Description of where the middleware came from (for logging)\n247:         \"\"\"\n248:         for spec in middleware_specs:\n249:             try:\n250:                 factory = self._load_function_from_string(spec)\n251:                 self.mcp_server_instance.add_middleware(factory())\n252:                 logger.info(f\"\u2705 Added middleware from {source}: {spec}\")\n253:             except Exception as e:  # noqa: BLE001\n254:                 logger.error(f\"\u274c Failed to add middleware '{spec}' from {source}: {e}\")\n255: \n256:     def _discover_entrypoint_middleware(self) -> list[str]:\n257:         \"\"\"Discover middleware from Python entrypoints in the 'jupyter_server_mcp.middleware' group.\n258: \n259:         Returns:\n260:             List of middleware specifications in 'module:factory' format\n261:         \"\"\"\n262:         if not self.use_middleware_discovery:\n263:             return []\n264: \n265:         try:\n266:             entrypoints = importlib.metadata.entry_points(\n267:                 group=\"jupyter_server_mcp.middleware\"\n268:             )\n269:         except Exception as e:  # noqa: BLE001\n270:             logger.error(f\"Failed to discover middleware entrypoints: {e}\")\n271:             return []\n272: \n273:         specs = [entry_point.value for entry_point in entrypoints]\n274:         logger.info(f\"Discovered {len(specs)} middleware from entrypoints\")\n275:         return specs\n276: \n277:     def initialize(self):\n278:         \"\"\"Initialize the extension.\"\"\"\n279:         super().initialize()\n280:         # serverapp will be available as self.serverapp after parent initialization\n281: \n282:     def initialize_handlers(self):\n283:         \"\"\"Initialize the handlers for the extension.\"\"\"\n284:         # No HTTP handlers needed - MCP server runs on separate port\n285: \n286:     def initialize_settings(self):\n287:         \"\"\"Initialize settings for the extension.\"\"\"\n288:         # Configuration is handled by traitlets\n289: \n290:     async def _confirm_mcp_server_started(self):\n291:         \"\"\"Wait for the MCP server to bind its port, or raise if startup fails.\"\"\"\n292:         task = self.mcp_server_task\n293:         instance = self.mcp_server_instance\n294:         if task is None or instance is None:\n295:             return\n296: \n297:         bound_wait = asyncio.ensure_future(instance.wait_until_bound())\n298:         try:\n299:             done, _ = await asyncio.wait(\n300:                 {task, bound_wait},\n301:                 timeout=self.mcp_startup_timeout,\n302:                 return_when=asyncio.FIRST_COMPLETED,\n303:             )\n304:         finally:\n305:             if not bound_wait.done():\n306:                 bound_wait.cancel()\n307:                 with contextlib.suppress(asyncio.CancelledError):\n308:                     await bound_wait\n309: \n310:         if task in done:\n311:             # The server task finished before binding \u2014 surface its exception.\n312:             await task\n313:             msg = \"MCP server exited during startup\"\n314:             raise RuntimeError(msg)\n315: \n316:         if bound_wait not in done:\n317:             msg = f\"MCP server did not bind within {self.mcp_startup_timeout} seconds\"\n318:             raise TimeoutError(msg)\n319: \n320:     async def _stop_mcp_server_task(self):\n321:         \"\"\"Stop the MCP server through its own shutdown path, then fall back.\"\"\"\n322:         if self.mcp_server_task is None or self.mcp_server_task.done():\n323:             return\n324: \n325:         self.log.info(\"Stopping MCP server\")\n326: \n327:         instance = self.mcp_server_instance\n328:         stop_server = getattr(instance, \"stop_server\", None)\n329:         if inspect.iscoroutinefunction(stop_server):\n330:             await stop_server()\n331:             try:\n332:                 await asyncio.wait_for(\n333:                     asyncio.shield(self.mcp_server_task),\n334:                     timeout=self.mcp_shutdown_timeout,\n335:                 )\n336:                 return\n337:             except TimeoutError:\n338:                 self.log.warning(\"Timed out waiting for MCP server to stop\")\n339: \n340:         self.mcp_server_task.cancel()\n341:         with contextlib.suppress(asyncio.CancelledError):\n342:             await self.mcp_server_task\n343: \n344:     async def start_extension(self):\n345:         \"\"\"Start the extension - called after Jupyter Server starts.\"\"\"\n346:         try:\n347:             port_desc = (\n348:                 \"an ephemeral port\" if self.mcp_port == 0 else f\"port {self.mcp_port}\"\n349:             )\n350:             self.log.info(f\"Starting MCP server '{self.mcp_name}' on {port_desc}\")\n351: \n352:             self.mcp_server_instance = MCPServer(\n353:                 parent=self, name=self.mcp_name, port=self.mcp_port\n354:             )\n355: \n356:             # Add middleware from entrypoints, then from configuration\n357:             self._add_middleware(\n358:                 self._discover_entrypoint_middleware(), source=\"entrypoints\"\n359:             )\n360:             self._add_middleware(self.mcp_middleware, source=\"configuration\")\n361: \n362:             # Register tools from entrypoints, then from configuration\n363:             entrypoint_tools = self._discover_entrypoint_tools()\n364:             self._register_tools(entrypoint_tools, source=\"entrypoints\")\n365:             self._register_tools(self.mcp_tools, source=\"configuration\")\n366: \n367:             # Start the MCP server in a background task\n368:             self.mcp_server_task = asyncio.create_task(\n369:                 self.mcp_server_instance.start_server()\n370:             )\n371: \n372:             await self._confirm_mcp_server_started()\n373: \n374:             bound_port = getattr(self.mcp_server_instance, \"port\", self.mcp_port)\n375:             registered_count = len(self.mcp_server_instance._registered_tools)\n376:             self.log.info(f\"\u2705 MCP server started on port {bound_port}\")\n377:             self.log.info(f\"Total registered tools: {registered_count}\")\n378: \n379:             self._publish_runtime_info()\n380: \n381:         except Exception as e:\n382:             if self.mcp_server_task and not self.mcp_server_task.done():\n383:                 self.mcp_server_task.cancel()\n384:                 with contextlib.suppress(asyncio.CancelledError):\n385:                     await self.mcp_server_task\n386: \n387:             self._clear_runtime_info()\n388:             self.mcp_server_task = None\n389:             self.mcp_server_instance = None\n390:             self.log.error(f\"Failed to start MCP server: {e}\")\n391:             raise\n392: \n393:     def _publish_runtime_info(self):\n394:         \"\"\"Write a runtime info file so the stdio proxy can discover this server.\"\"\"\n395:         try:\n396:             server = self.mcp_server_instance\n397:             bind_host = getattr(server, \"host\", \"localhost\") or \"localhost\"\n398:             port = getattr(server, \"port\", self.mcp_port)\n399:             pid = os.getpid()\n400:             path = info_file_path(jupyter_runtime_dir(), pid)\n401:             # The bind host can be a wildcard like \"0.0.0.0\" or \"::\" \u2014 those\n402:             # are valid bind addresses but not usable as connect targets.\n403:             url_host = _url_host(_connect_host(bind_host))\n404:             info = {\n405:                 \"pid\": pid,\n406:                 \"host\": bind_host,\n407:                 \"port\": port,\n408:                 \"url\": f\"http://{url_host}:{port}/mcp\",\n409:                 \"name\": self.mcp_name,\n410:                 \"root_dir\": self._detect_root_dir(),\n411:             }\n412:             write_info_file(path, info)\n413:         except Exception as exc:  # noqa: BLE001\n414:             self.log.warning(f\"Could not publish MCP runtime info: {exc}\")\n415:             self._runtime_info_path = None\n416:             return\n417: \n418:         self._runtime_info_path = path\n419:         self.log.info(f\"Wrote MCP runtime info file: {path}\")\n420: \n421:     def _clear_runtime_info(self):\n422:         \"\"\"Remove the runtime info file if one was written.\"\"\"\n423:         path = self._runtime_info_path\n424:         if path is None:\n425:             return\n426:         try:\n427:             remove_info_file(path)\n428:         except OSError as exc:\n429:             self.log.warning(f\"Could not remove MCP runtime info file {path}: {exc}\")\n430:         finally:\n431:             self._runtime_info_path = None\n432: \n433:     def _detect_root_dir(self) -> str:\n434:         \"\"\"Return the Jupyter server's root directory, falling back to CWD.\"\"\"\n435:         serverapp = getattr(self, \"serverapp\", None)\n436:         root_dir = getattr(serverapp, \"root_dir\", None)\n437:         if root_dir:\n438:             return str(Path(root_dir).resolve())\n439:         return str(Path.cwd().resolve())\n440: \n441:     async def _start_jupyter_server_extension(self, serverapp):  # noqa: ARG002\n442:         \"\"\"Start the extension - called after Jupyter Server starts.\"\"\"\n443:         await self.start_extension()\n444: \n445:     async def stop_extension(self):\n446:         \"\"\"Stop the extension - called when Jupyter Server shuts down.\"\"\"\n447:         try:\n448:             await self._stop_mcp_server_task()\n449:         finally:\n450:             self._clear_runtime_info()\n451:             self.mcp_server_task = None\n452:             self.mcp_server_instance = None\n453:         self.log.info(\"MCP server stopped\")\n\n(End of file - total 453 lines)\n</content>"
